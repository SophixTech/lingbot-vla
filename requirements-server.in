# Linux x86_64, CPython 3.10.12, CUDA 12.8 training profile.
# LeRobot and the editable projects are installed separately with --no-deps:
# their upstream metadata conflicts with this repository's training versions.
-r requirements.txt
# Explicit official wheels avoid routing unrelated packages to the PyTorch index.
torch @ https://download.pytorch.org/whl/cu128/torch-2.8.0%2Bcu128-cp310-cp310-manylinux_2_28_x86_64.whl
torchvision @ https://download.pytorch.org/whl/cu128/torchvision-0.23.0%2Bcu128-cp310-cp310-manylinux_2_28_x86_64.whl
torchaudio @ https://download.pytorch.org/whl/cu128/torchaudio-2.8.0%2Bcu128-cp310-cp310-manylinux_2_28_x86_64.whl
